{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/painel/contexto.js\"", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/painel/lembrete.js\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/painel/salvar.js\" --auto --fundo", "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node painel/contexto.js:*)",
      "Bash(node painel/salvar.js:*)",
      "Bash(node painel/ligar.js:*)",
      "Bash(npm run painel)",
      "Bash(npm run parar)",
      "Bash(npm run status)",
      "Bash(npm run salvar:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git remote -v)"
    ]
  }
}
